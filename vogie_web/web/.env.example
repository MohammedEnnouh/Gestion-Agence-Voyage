# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_NAME="Vogie"
APP_URL=http:
APP_KEY=base64:YOUR_APP_KEY_HERE

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vogie_web
DB_USERNAME=root
DB_PASSWORD=

# Stripe Configuration
STRIPE_KEY=pk_test_51Pe5DrDW9NzzBWTtvTKSAGaCxmzOb1us4eve170c9zYIcknAh3I4HcQhnUhfyLk8kd1ML8u4qmOzX8Pzi0WHOfvn00ujylHqyb
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@vogie.com"
MAIL_FROM_NAME="${APP_NAME}"

# Application Settings
TIMEZONE=Africa/Casablanca
LOCALE=fr
FALLBACK_LOCALE=fr

# File Uploads
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=12M

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1
SESSION_DOMAIN=localhost

# Google reCAPTCHA (optional)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Google Maps API (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Socialite (optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=

# Debugbar (development only)
DEBUGBAR_ENABLED=true

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Trusted Proxies (if behind load balancer)
# TRUSTED_PROXIES=*